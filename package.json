{
  "name": "mrstreamer-workspace",
  "private": true,
  "type": "module",
  "description": "Mr. Streamer: the desktop app in apps/desktop, shared contracts and rules in packages.",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "pnpm --filter mrstreamer dev",
    "build": "pnpm --filter mrstreamer build",
    "start": "pnpm --filter mrstreamer start",
    "typecheck": "tsc --noEmit -p packages/contracts && tsc --noEmit -p packages/core && tsc --noEmit -p apps/desktop && tsc --noEmit -p apps/desktop/src/renderer && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "knip": "knip",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "dist:mac": "pnpm --filter mrstreamer dist:mac",
    "dist:win": "pnpm --filter mrstreamer dist:win",
    "dist:msix": "pnpm --filter mrstreamer dist:msix",
    "dist:linux": "pnpm --filter mrstreamer dist:linux"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0",
  "devDependencies": {
    "@types/node": "^24.19.0",
    "happy-dom": "20.14.5",
    "knip": "6.38.0",
    "oxlint": "1.86.0",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
