{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "oxc"],
  "jsPlugins": [{ "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }],
  "ignorePatterns": [
    "node_modules/",
    "out/",
    "dist/",
    "vendor/",
    ".local/",
    "apps/ios/ios/",
    "apps/ios/build/",
    "apps/ios/.expo/",
    "apps/android/android/",
    "apps/android/.expo/",
    "apps/marketing/public/generated/",
    "apps/marketing/.vercel/",
    "tools/oxlint/anti-slop/"
  ],
  "rules": {
    "unicorn/no-useless-spread": "off",
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/bad-array-method-on-arguments": "off",
    "oxc/bad-char-at-comparison": "off",
    "oxc/bad-comparison-sequence": "off",
    "oxc/bad-match-all-arg": "off",
    "oxc/bad-min-max-func": "off",
    "oxc/bad-object-literal-comparison": "off",
    "oxc/bad-replace-all-arg": "off",
    "oxc/const-comparisons": "off",
    "oxc/double-comparisons": "off",
    "oxc/erasing-op": "off",
    "oxc/missing-throw": "off",
    "oxc/number-arg-out-of-range": "off",
    "oxc/only-used-in-recursion": "off",
    "oxc/uninvoked-array-callback": "off",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-known-value-widening": "off",
    "anti-slop/no-module-mocking": "off",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-runtime-typeof": "off",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "off",
    "anti-slop/no-unknown-returns": "off",
    "anti-slop/no-unknown-type-aliases": "off",
    "anti-slop/no-unsafe-dictionary-type": "off",
    "anti-slop/no-widen-then-assert": "off",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["**/*"],
      "plugins": ["import", "typescript", "react", "promise", "oxc"],
      "rules": {
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-props-no-spread-multi": "error",
        "react/no-danger-with-children": "error",
        "react/void-dom-elements-no-children": "error",
        "promise/no-multiple-resolved": "error",
        "promise/valid-params": "error",
        "promise/no-new-statics": "error"
      }
    },
    {
      "files": ["apps/desktop/src/renderer/**"],
      "plugins": ["import", "typescript", "react", "promise", "oxc"],
      "rules": {
        "react/rules-of-hooks": "error"
      }
    },
    {
      "files": ["packages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Packages run without Electron: pass a capability in."
              },
              { "name": "react", "message": "Packages run without React." },
              { "name": "react-dom", "message": "Packages run without the DOM." },
              { "name": "mrstreamer", "message": "Packages don't depend on the app." }
            ],
            "patterns": [
              { "group": ["**/apps/**"], "message": "Packages don't depend on the app." }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/contracts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "electron", "message": "Contracts are plain data." },
              { "name": "react", "message": "Contracts are plain data." }
            ],
            "patterns": [
              {
                "group": ["@mrstreamer/core", "@mrstreamer/core/*", "**/apps/**", "**/core/**"],
                "message": "Contracts depend on nothing else in the workspace."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/**", "apps/desktop/test/**"],
      "excludeFiles": ["apps/desktop/src/main/services/**", "apps/desktop/src/main/playback/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/playback/receiver-delivery", "**/playback/receiver-delivery.ts"],
                "message": "Receiver delivery belongs to Playback. Open sessions through the Playback service."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/main/services/**"],
      "excludeFiles": ["apps/desktop/src/main/services/playback.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ipc.ts", "**/handlers/**"],
                "message": "Services are independent of IPC transport and request adapters."
              },
              {
                "group": ["**/playback/receiver-delivery", "**/playback/receiver-delivery.ts"],
                "message": "Receiver delivery belongs to Playback. Open sessions through the Playback service."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/desktop/src/main/services/playback.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/ipc.ts", "**/handlers/**"],
                "message": "Services are independent of IPC transport and request adapters."
              }
            ]
          }
        ]
      }
    }
  ]
}
