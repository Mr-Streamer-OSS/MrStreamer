diff --git a/ios/VideoExceptions.swift b/ios/VideoExceptions.swift
index 71766387e6e661c112a05cf32c19723508e8ffa8..0fba324eb3a74c2f642616a239eafb777aab3deb 100644
--- a/ios/VideoExceptions.swift
+++ b/ios/VideoExceptions.swift
@@ -51,3 +51,14 @@ internal final class VideoCacheUnsupportedFormatException: GenericException<Stri
     "The server responded with a resource with mimeType: \(param) which cannot be played with caching enabled"
   }
 }
+
+internal extension Error {
+  /// The error for a log: its domain and code, and its underlying error's. A source's address can
+  /// carry a login (IPTV panels put the username and password in the path), and an error's
+  /// description or user info can quote that address, so neither is included.
+  var withoutAddress: String {
+    let failure = self as NSError
+    let cause = (failure.userInfo[NSUnderlyingErrorKey] as? NSError).map { " (\($0.domain) \($0.code))" } ?? ""
+    return "\(failure.domain) \(failure.code)\(cause)"
+  }
+}
