diff --git a/ios/RNSScreenStackHeaderConfig.mm b/ios/RNSScreenStackHeaderConfig.mm
index 3db8d1fbedd36368f60ac0f0efd82006b71f6bde..db162a28e93999c09b1163df97c291d7344c1423 100644
--- a/ios/RNSScreenStackHeaderConfig.mm
+++ b/ios/RNSScreenStackHeaderConfig.mm
@@ -158,7 +158,32 @@ RNS_IGNORE_SUPER_CALL_END
     // As the header might have change in `updateViewController` we need to ensure that header height
     // returned by the `onHeaderHeightChange` event is correct.
     [self.screenView.controller calculateAndNotifyHeaderHeightChangeIsModal:NO];
+  } else {
+    [self updateBackItemOfScreenAbove];
+  }
+}
+
+/**
+ * A screen under the visible one is configured again only once it shows, so the back button of
+ * the screen above it would keep its old title, as after a change of the app's language. Keeps
+ * this screen's title current and the back button above it following it.
+ */
+- (void)updateBackItemOfScreenAbove
+{
+#if !TARGET_OS_TV
+  UIViewController *vc = _screenView.controller;
+  if (vc == nil || ![vc.parentViewController isKindOfClass:UINavigationController.class]) {
+    return;
+  }
+  NSArray<UIViewController *> *stack = ((UINavigationController *)vc.parentViewController).viewControllers;
+  NSUInteger index = [stack indexOfObject:vc];
+  if (index == NSNotFound || index + 1 >= stack.count || ![stack[index + 1] isKindOfClass:RNSScreen.class]) {
+    return;
   }
+  vc.navigationItem.title = self.title;
+  RNSScreenStackHeaderConfig *above = static_cast<RNSScreen *>(stack[index + 1]).screenView.findHeaderConfig;
+  [above configureBackItem:vc.navigationItem withPrevVC:vc];
+#endif // !TARGET_OS_TV
 }
 
