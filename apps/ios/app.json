{
  "expo": {
    "name": "Mr. Streamer",
    "slug": "mrstreamer",
    "scheme": "mrstreamer",
    "version": "0.2.0",
    "platforms": ["ios"],
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "experiments": {
      "tsconfigPaths": false
    },
    "ios": {
      "bundleIdentifier": "app.mrstreamer.player",
      "buildNumber": "19",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSBonjourServices": ["_googlecast._tcp"],
        "NSLocalNetworkUsageDescription": "Mr. Streamer uses your local network to reach a provider on it, and to find TVs and play to them when you choose Play on TV."
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ]
    ]
  }
}
