{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["electron"],
      "entry": [
        "scripts/*.ts",
        "test/**/*.test.ts",
        ".cursor/skills/verify-mrstreamer/scripts/*.ts"
      ]
    },
    "apps/desktop": {
      "entry": [
        "scripts/*.{ts,mjs}",
        "test/e2e/*.ts",
        "test/renderer/download-performance.config.ts",
        "test/renderer/download-performance.probe.ts"
      ]
    },
    "apps/marketing": {
      "entry": ["scripts/*.ts"]
    },
    "apps/review-provider": {
      "entry": ["test/worker.ts"]
    },
    "packages/*": {}
  },
  "ignoreIssues": { "tools/oxlint/anti-slop/**": ["exports", "types"] },
  "ignoreUnresolved": ["^\\$ACTION_PATH/\\.\\./\\.\\./\\.\\./scripts/test-durations\\.ts$"],
  "ignoreBinaries": [
    "ffmpeg",
    "ffprobe",
    "fc-match",
    "electron-builder",
    "script",
    "openssl",
    "osascript",
    "dbus-send"
  ]
}
